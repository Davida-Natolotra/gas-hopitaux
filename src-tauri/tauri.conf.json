{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GAS Hopitaux",
  "version": "1.0.5",
  "identifier": "com.rdavi.hopitaux",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GAS Hopitaux",
        "width": 1366,
        "height": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "minimumWebview2Version": "109.0.1518.78"
    }
  }
}
